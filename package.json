{
  "name": "ecommerce-qa-automation-suite",
  "version": "1.0.0",
  "description": "Comprehensive QA automation suite for e-commerce platform validation using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report",
    "report:allure": "allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "qa",
    "ecommerce"
  ],
  "author": "Abhishek Das",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "allure-playwright": "^3.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "docx": "^9.7.1"
  }
}
